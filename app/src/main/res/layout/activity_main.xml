<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CATATAN PENGELUARAN"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#6C4AB6"
            android:gravity="center"
            android:padding="15dp"/>

        <EditText
            android:id="@+id/etNama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama pengeluaran"
            android:inputType="textCapSentences"/>

        <EditText
            android:id="@+id/etJumlah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Jumlah pengeluaran (Rp)"
            android:inputType="number"/>

        <Button
            android:id="@+id/btnSimpan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simpan Pengeluaran"
            android:backgroundTint="#6C4AB6"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daftar Pengeluaran"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#6C4AB6"
            android:paddingTop="25dp"/>

        <TextView
            android:id="@+id/tvDaftar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada pengeluaran"
            android:textSize="16sp"
            android:textColor="#333333"
            android:padding="10dp"/>

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Pengeluaran: Rp 0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#6C4AB6"
            android:padding="15dp"/>

    </LinearLayout>
</ScrollView>